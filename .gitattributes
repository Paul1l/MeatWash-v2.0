# Текстовые файлы хранятся и выдаются с LF: на Windows core.autocrlf=true,
# и без этого правки меняли бы переводы строк во всём файле.
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
